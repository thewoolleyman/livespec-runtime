// Project-local livespec configuration for livespec-runtime.
//
// This sibling library dogfoods livespec at the LIBRARY scale, second
// such (livespec-dev-tooling was first). The SPECIFICATION/ tree at the
// repo root is the live spec for this library; this library's own impl
// tracking lives in a per-repo beads/Dolt TENANT database on the shared
// dolt-server (tenant name "livespec-runtime"), via livespec-orchestrator-beads-fabro.
// (The pre-cutover plaintext work-items.jsonl / memos.jsonl snapshot is
// frozen read-only under archive/ — see archive/README.md.)
//
// Authority: livespec/SPECIFICATION/contracts.md
//   §"Cross-repo coordination — pin-and-bump" (sibling libraries take
//   the same pin-and-bump shape as impl-plugins)
//   §"Cross-repo dependency awareness" (the H2 landed by li-e7h6ki +
//   parent epic li-6d2wpj that names livespec-runtime as the shared
//   runtime library)
//
// Status: SPECIFICATION/ is seeded via /livespec:seed as a follow-up
// after the v0.1.0 tag lands (per li-ufvfmb's "seed its own
// SPECIFICATION/ via the livespec template"). The initial scaffold ships
// the .livespec.jsonc and the package skeleton; the cross_repo impl
// lands via li-aclzfe against the seeded spec.
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      { "name": "thewoolleyman-factory-bot[bot]", "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com" }
    ]
  },
  // Foreman human-valve disposition. Opts this repo's foreman seat into the
  // CONSENSUS tier: a human valve or blocked session may be disposed by a
  // unanimous review panel through foreman-act, instead of being surfaced
  // report-only and left to sit. Enabled 2026-08-21 at the maintainer's
  // explicit fleet-wide direction. The resolver's fail-closed default is
  // "report-only", so an UNSET repo silently surfaces valves and never acts
  // on them -- which is what this key exists to prevent. The contract floors
  // are NOT relaxed: dissent, insufficient information, hard-risk, and
  // human-gated-by-design decisions still escalate regardless of any panel
  // verdict.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // Optional — spec_governance:
  // "spec_governance": {
  //   "propose_change_mode": "interactive",
  //   "critique_mode": "interactive",
  //   "in_flight_alignment": "prompt",
  //   "doctor_dispositions": {},
  //   "revise_decision_mode": "manual",
  //   "drift_acceptance_mode": "human",
  //   "ratification_review": "manual-spawn",
  //   "ratification_reviewer_model": null,
  //   "ratification_min_review_age_seconds": 1,
  //   "spec_pr_merge": "manual"
  // }
  // Active spec_governance overrides (maintainer-directed fleet-wide
  // spec-side-autonomy lever rollout, epic livespec-jvdvx4). Every remaining
  // key keeps the shipped default documented in the comment block above,
  // except drift_acceptance_mode (no safe autonomous value exists yet — it
  // is fail-closed pending the unbuilt Increment-3 consensus panel) and
  // doctor_dispositions (deferred to a separate follow-up; populating it
  // needs real per-check-id judgment).
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    // ratification_review: "auto-spawn" is inert without a configured
    // reviewer model (effective.py's effective_ratification_review returns
    // requires_input=True when ratification_reviewer_model is None) — set
    // to "fable", matching livespec core's own convention.
    // SUPERSEDED 2026-08-26 by PR #632: the active designation is "opus",
    // changed fleet-wide after exhausted Fable capacity hard-blocked spec
    // ratification in four repos (this one, livespec core, livespec-overseer,
    // livespec-console-beads-fabro). The line above is kept verbatim as the
    // original intent; it no longer describes the value below. Note this is a
    // REPLACEMENT, not a fallback: exactly one model is designated, so the
    // single point of failure moved from fable to opus rather than being
    // removed. The ordered-reviewer-list fallback was considered and
    // CANCELLED by maintainer ruling, so no fallback is pending.
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": "opus",
    "spec_pr_merge": "auto-on-green"
  },
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs so a bare invocation self-heals its tenant secret.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "harnesses": {
    "claude": { "status": "exempt", "reason": "livespec-runtime is a library; it ships no command/skill surface to resolve from a harness" },
    "codex":  { "status": "exempt", "reason": "livespec-runtime is a library; it ships no command/skill surface to resolve from a harness" }
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by cross-tenant DependsOnEntry refs (`sibling_work_item`,
  // `pull_request`, and `branch`) so the Dispatcher readiness gate can fail
  // closed on still-open sibling work.
  "cross_repo_targets": {
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    },
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    }
  },
  "livespec-runtime": {
    "compat": {
      // semver range and pinned tag against livespec-core. The pinned
      // value is "master" until livespec-core's first post-v072 release
      // tag (revising the propose-change from li-e7h6ki); doctor's
      // contract-version-compatibility invariant currently fires `warn`
      // against "master" pins, which is expected during bootstrap.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.38.5"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    // Substrate marker. The plaintext sibling declared "jsonl"; this
    // plugin's substrate is a per-repo beads/Dolt TENANT database on the
    // shared dolt-server (NOT JSONL files at the repo root). The frozen
    // pre-cutover JSONL snapshot lives under archive/ (see archive/README.md).
    "format": "beads",
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.38.5"
    },
    // Per-repo beads tenant CONNECTION block, read by the plugin's
    // commands/_config.py and overlaid by LIVESPEC_BD_PATH /
    // LIVESPEC_BEADS_FAKE. `prefix` == `tenant` == `database` ==
    // `server_user` is the load-bearing tenant identity rule (all four are
    // this repo's name, "livespec-runtime"). TCP-only: NO `socket` key —
    // the dolt unix socket dir is 0750 dolt:dolt and inaccessible to this
    // caller, so the connection must go over 127.0.0.1:3307.
    //
    // The tenant PASSWORD is deliberately ABSENT — it is supplied only via
    // the BEADS_DOLT_PASSWORD environment variable at bd-call time and is
    // NEVER committed here.
    //
    // `fake` is false so the committed config describes the REAL
    // connection; CI and tests set LIVESPEC_BEADS_FAKE=1 to force the
    // hermetic in-memory backend (GitHub CI cannot reach the localhost
    // dolt-server).
    "connection": {
      "tenant": "livespec-runtime",
      "prefix": "livespec-runtime",
      "database": "livespec-runtime",
      "server_user": "livespec-runtime",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      // Work-item hosting this tenant's detection-coverage records. Without a
      // committed anchor, record_detection_run returns AnchorNotConfigured and
      // writes NOTHING, so the hygiene gather reports "gap-capture coverage is
      // stale, last completed coverage point: none on record" forever no matter
      // how many capture passes actually run. Provisioned 2026-09-07 working
      // livespec-runtime-ld2, whose acceptance (needs-attention stops emitting
      // hygiene:gap-capture-staleness) was UNSATISFIABLE without it — a
      // prerequisite that item's description never named. Measured that day: no
      // repo in this fleet had provisioned one. livespec-orchestrator-beads-fabro
      // carries the key as the empty string, which its own comment calls "the
      // committed spelling of not yet provisioned"; livespec-dev-tooling,
      // livespec and livespec-overseer do not carry the key at all. This
      // repository is the first.
      //
      // The anchor is an ANCHOR, not a unit of work: it is never done and MUST
      // NOT be closed. Only record_detection_run writes to it. A hand-authored
      // comment shaped like a coverage record would make the hygiene gather
      // report a coverage point no run ever earned — worse than the staleness it
      // would silence.
      "detection_coverage_anchor": "livespec-runtime-s5k",
      // Throughput tuning parameter, not a spec commitment: contracts.md
      // names 5 only as the DEFAULT, so a committed non-negative integer
      // exercises the key rather than amending the spec. Raised to 10
      // (maintainer-directed 2026-08-20) because the hp factory was
      // refusing dispatches with `capacity-deferred` at 5.
      "wip_cap": 10,
      // Sandbox toolchain + conformance premises (livespec-runtime-m1q, plan
      // runtime-backlog-drain batch 1, 2026-09-06). Since orchestrator
      // 39526e5c every one of these five prepare steps is a PROJECTION of
      // this repository's own declaration, and an undeclared premise is the
      // ratified explicit NO-OP. With nothing declared here the tier-0
      // canary dispatch (fabro 01M1TQDWS8PCQJ90HMZJ66EHHM) died in setup:
      // `mise trust` never ran, so the mise-managed `uv sync --all-groups`
      // refused the untrusted .mise.toml. Worse, a run that got past setup
      // would have installed no commit-refuse hook and read green without
      // the Red-Green-Replay gates. Values mirror livespec-dev-tooling's
      // block, which is the schema author's own and the fleet's proven
      // shape. `internal_livespec_dev_tooling` renders
      // `uv run python -m livespec_dev_tooling.<module>`; this repo's dev
      // group installs that package, and the `uv sync --all-groups` prepare
      // step runs immediately before the conformance trio.
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      "auto_approve_ready": true,
      "acceptance_mode": "ai-only",
      "factories": {
        "hp": { "server": "https://hp-xubuntu.perch-rudd.ts.net:32276" },
        "vps": { "server": "https://vps.perch-rudd.ts.net:32276" }
      },
      "default_factory": "hp"
    }
  }
}
